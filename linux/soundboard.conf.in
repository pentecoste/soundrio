# Soundrio virtual audio devices.
#
# Runs as a standalone PipeWire client (soundboard-audio.service):
#     pipewire -c soundboard.conf
# so it can be restarted without touching the main audio daemon:
#     systemctl --user restart soundboard-audio
#
# Resulting graph:
#
#   microphone ---------------------------------.
#                                               v
#   Soundrio -> MixedOutput --+--> SoundBoard --> SoundBoardMic -> voice apps
#                             '--> speakers
#
# Every node has a fixed node.name: the session manager links them whenever
# they show up (in any order), and volumes/connections are remembered across
# reboots.
#
# Generated by linux/install.sh. Re-run it with --mic / --speakers to change
# the two devices below.

context.properties = {
    log.level = 2
}

context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}

context.modules = [
    { name = libpipewire-module-rt
        args = { }
        flags = [ ifexists nofail ]
    }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }

    # SoundBoard (sink) -> SoundBoardMic (source): whatever is played into the
    # sink comes out of the virtual microphone that voice apps record from.
    { name = libpipewire-module-loopback
        args = {
            audio.position = [ FL FR ]
            capture.props = {
                media.class      = Audio/Sink
                node.name        = "SoundBoard"
                node.description = "SoundBoard"
            }
            playback.props = {
                media.class      = Audio/Source
                node.name        = "SoundBoardMic"
                node.description = "Microphone + Soundboard"
            }
        }
    }

    # Microphone -> SoundBoard.
    # Mono on both sides: the capture links 1:1 to a mono microphone port
    # (dont-remix), the playback is duplicated on FL and FR of the sink.
    # dont-fallback: if the target is missing, stay unlinked instead of
    # latching onto the default device (which would create a feedback loop or
    # send your voice to the speakers).
    { name = libpipewire-module-loopback
        args = {
            audio.position = [ MONO ]
            capture.props = {
                node.name          = "soundboard.mic.capture"
                node.description   = "Mic -> SoundBoard (input)"
                target.object      = "@MIC@"
                node.dont-fallback = true
                stream.dont-remix  = true
            }
            playback.props = {
                node.name          = "soundboard.mic.playback"
                node.description   = "Mic -> SoundBoard (output)"
                target.object      = "SoundBoard"
                node.dont-fallback = true
            }
        }
    }

    # MixedOutput: what is played here (Soundrio) goes both to the others
    # (SoundBoard) and to your speakers. Each branch is created when its sink
    # appears, so startup order does not matter.
    { name = libpipewire-module-combine-stream
        args = {
            combine.mode     = sink
            node.name        = "MixedOutput"
            node.description = "Mixed Output"
            combine.latency-compensate = false
            combine.props = {
                audio.position = [ FL FR ]
            }
            stream.props = { }
            stream.rules = [
                {
                    matches = [
                        { media.class = "Audio/Sink"
                          node.name   = "SoundBoard" }
                        { media.class = "Audio/Sink"
                          node.name   = "@SPEAKERS@" }
                    ]
                    actions = { create-stream = { } }
                }
            ]
        }
    }
]
